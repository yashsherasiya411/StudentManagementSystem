@model Student
@{
    ViewData["Title"] = "Student Details";
}
<h2>Student Details</h2>
<dl class="row">
    <dt class="col-sm-3">Full Name</dt><dd class="col-sm-9">@Model.FullName</dd>
    <dt class="col-sm-3">Email</dt><dd class="col-sm-9">@Model.Email</dd>
    <dt class="col-sm-3">Phone</dt><dd class="col-sm-9">@Model.Phone</dd>
    <dt class="col-sm-3">Course</dt><dd class="col-sm-9">@Model.Course</dd>
    <dt class="col-sm-3">Semester</dt><dd class="col-sm-9">@Model.Semester</dd>
    <dt class="col-sm-3">Enrolled On</dt><dd class="col-sm-9">@Model.EnrollmentDate.ToString("dd MMM yyyy")</dd>
</dl>
<a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
<a class="btn btn-link" asp-action="Index">Back to list</a>
