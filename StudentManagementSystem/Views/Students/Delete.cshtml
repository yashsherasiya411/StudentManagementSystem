@model Student
@{
    ViewData["Title"] = "Delete Student";
}
<h2>Delete Student</h2>
<p class="text-danger">Are you sure you want to delete this student record?</p>
<dl class="row">
    <dt class="col-sm-3">Name</dt><dd class="col-sm-9">@Model.FullName</dd>
    <dt class="col-sm-3">Email</dt><dd class="col-sm-9">@Model.Email</dd>
    <dt class="col-sm-3">Course</dt><dd class="col-sm-9">@Model.Course</dd>
</dl>
<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a class="btn btn-link" asp-action="Index">Cancel</a>
</form>
