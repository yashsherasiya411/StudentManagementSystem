@model List<Student>
@{
    ViewData["Title"] = "Students";
    var courses = (List<string>)ViewBag.Courses;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0">Students</h2>
        <small class="text-muted">Total records: @ViewBag.Total</small>
    </div>
    <a class="btn btn-primary" asp-action="Create">+ Add Student</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-12 col-md-5">
        <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search by name or email" />
    </div>
    <div class="col-8 col-md-4">
        <select name="course" class="form-select">
            <option value="">All courses</option>
            @foreach (var c in courses)
            {
                <option value="@c" selected="@(c == (string?)ViewBag.Course)">@c</option>
            }
        </select>
    </div>
    <div class="col-4 col-md-3 d-grid">
        <button class="btn btn-outline-secondary" type="submit">Search</button>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
            <tr><th>Name</th><th>Email</th><th>Course</th><th>Sem</th><th></th></tr>
        </thead>
        <tbody>
            @foreach (var s in Model)
            {
                <tr>
                    <td>@s.FullName</td>
                    <td>@s.Email</td>
                    <td>@s.Course</td>
                    <td>@s.Semester</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@s.Id">View</a>
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@s.Id">Edit</a>
                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@s.Id">Delete</a>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="5" class="text-center text-muted">No students found.</td></tr>
            }
        </tbody>
    </table>
</div>
